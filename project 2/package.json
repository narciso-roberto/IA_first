{
  "name": "weekly-project-progress-tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace @weekly-tracker/client",
    "dev:server": "npm run dev --workspace @weekly-tracker/server",
    "build": "npm run build --workspace @weekly-tracker/client && npm run build --workspace @weekly-tracker/server",
    "test": "npm run test --workspace @weekly-tracker/server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
