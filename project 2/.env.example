# Local development only. Copy this file to .env and set a private password.
POSTGRES_DB=weekly_tracker
POSTGRES_USER=weekly_tracker
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# Keep these connection details aligned with the POSTGRES_* values above.
DATABASE_URL=postgresql://weekly_tracker:replace-with-a-local-development-password@localhost:5432/weekly_tracker?schema=public
